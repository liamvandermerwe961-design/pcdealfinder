{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pcdealfinder",
  "compatibility_date": "2026-08-17",
  "assets": {
    "directory": "."
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pcdealfinder-db",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ]
}
